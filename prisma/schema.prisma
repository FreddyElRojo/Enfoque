generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "sqlite"
  url      = "file:./prisma/dev.db"
}

model UserSettings {
  id        Int      @id @default(autoincrement())
  workTime  Int      @default(25)  // minutos de trabajo (Pomodoro default)
  breakTime Int      @default(5)   // minutos de descanso
  longBreak Int      @default(15)  // descanso largo
  createdAt DateTime @default(now())
}

model DailyLog {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique
  hoursWorked Float    @default(0)
  goalsMet    Boolean  @default(false)
  streak      Int      @default(0)
  notes       String?
}

model Task {
  id                 Int       @id @default(autoincrement())
  description        String    // SQLite: TEXT (longitud ilimitada, validamos en la app)
  estimatedMinutes   Int       // SQLite: INTEGER
  actualMinutes      Int?      // Null hasta completada
  status             TaskStatus @default(NOT_STARTED)
  active             Boolean   @default(false)   // Solo una tarea activa a la vez
  date               DateTime  // Prisma guarda como TEXT ISO (ej: "2026-01-20")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([date])     // Para queries rápidas por día y limpieza automática
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  COMPLETED
}